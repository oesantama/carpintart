# ==============================================================================
# CarpintArt ERP - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a ".env" en la raíz del proyecto:
#    cp .env.example .env
# 2. Reemplaza los valores con tus credenciales reales de Google Cloud Console.
# 3. NUNCA subas el archivo ".env" al repositorio público de Git.
# ==============================================================================

# ID de la carpeta en Google Drive donde se almacenarán las fotos y comprobantes
# (Usa "root" para crear la carpeta principal "CarpintArt_ERP_System" en tu unidad raíz)
GOOGLE_DRIVE_FOLDER_ID=root

# Credenciales de Google Cloud OAuth 2.0 (Client ID y Client Secret para Web / Desktop)
GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_cliente_secret_aqui

# Refresh Token generado para renovar el Access Token automáticamente
GOOGLE_REFRESH_TOKEN=tu_refresh_token_aqui
